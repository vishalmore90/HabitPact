# Discord Bot Token (REQUIRED — from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Database URL
# Dev:  sqlite+aiosqlite:///habitpact.db
# Prod: postgresql+asyncpg://user:pass@host:5432/habitpact
DATABASE_URL=sqlite+aiosqlite:///habitpact.db

# Log level
LOG_LEVEL=INFO

# Environment (dev/prod)
ENVIRONMENT=dev
